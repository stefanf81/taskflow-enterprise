.git
.github
.idea
.DS_Store

.env
*.log

.gradle
out/
node_modules/
*.class
*.jar
# The backend Dockerfile consumes the pre-built Spring Boot executable JAR.
# Keep only the boot artifact in the Docker build context.
!build/libs/*.jar
*.war

src/
gradle/
gradlew
gradlew.bat
build.gradle
build.gradle.kts
settings.gradle
settings.gradle.kts
gradle.properties

# Exclude build subdirectories explicitly rather than using `build/*` because
# Docker BuildKit does not reliably re-include directories excluded by a
# parent wildcard pattern (observed with docker-container driver on Docker
# 28.x).  `build/libs/` is never excluded so the pre-built JAR is always
# included in the build context.
build/classes/
build/generated/
build/reports/
build/resources/
build/tmp/
build/test-results/

frontend/
mobile/
docs/
k6/
scripts/
jaeger/
# The image needs only the boot JAR. `node_modules/` above matches the root only;
# shared/ (the zod schemas, 6 MB with their node_modules) and the rest were sent to
# the builder on every backend build.
**/node_modules/
shared/
api/
.claude/
.opencode/
.zap/
*.md
