# =========================================================================================
#
# Production Spring Boot image
#
# Design goals:
#
# • Fast incremental Docker builds through layered Spring Boot extraction.
# • Fast cold starts using Spring AOT and JVM Class Data Sharing (CDS).
# • Container-portable JVM tuning that adapts automatically to runtime limits.
# • Kubernetes-friendly runtime (non-root, fixed UID/GID, proper PID 1).
# • Small production runtime image containing only the JRE and application.
#
# =========================================================================================

# =========================================================================================
# STAGE 1: LAYER EXTRACTION
#
# linux/amd64 is pinned explicitly so builds on Apple Silicon cross-compile via
# QEMU to match the target cloud runtime rather than accidentally producing
# arm64 binaries.
#
# This stage only runs `java -Djarmode=tools ... extract`, a pure JRE operation
# that splits the fat jar into deterministic Docker layers. No JDK is needed —
# the JDK is dead weight here, especially under QEMU emulation.
# =========================================================================================

ARG PLATFORM=linux/amd64

FROM --platform=$PLATFORM eclipse-temurin:21-jre-alpine AS extractor

WORKDIR /app

# Copy the pre-built jar from the build context.
#
# A wildcard is used instead of a hardcoded filename (e.g. taskflow.jar) because:
#   1. Spring Boot's bootJar task includes the project version in the archive name
#      (taskflow-0.0.1-SNAPSHOT.jar), which changes with every release.
#   2. CI artifact download (actions/download-artifact) may preserve directory
#      prefixes differently across workflow versions.
#
# This glob must match exactly ONE jar. Only the bootJar should be in build/libs/
# before building this image (the plain jar is disabled via `jar { enabled = false }`
# in build.gradle).
COPY build/libs/*.jar application.jar

RUN java \
    -Djarmode=tools \
    -jar application.jar \
    extract \
    --layers \
    --launcher \
    --destination extracted

# =========================================================================================
# STAGE 2: RUNTIME
# =========================================================================================

FROM --platform=$PLATFORM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Install tini and create a dedicated non-root runtime user.
#
# Running Java under tini ensures PID 1 correctly forwards Unix signals and
# reaps orphaned child processes, avoiding the shutdown and zombie-process
# issues that occur when applications run directly as PID 1 inside containers.
#
# A fixed numeric UID/GID is used instead of dynamically allocated IDs. This
# avoids permission mismatches on mounted volumes and satisfies Kubernetes Pod
# Security Standards requiring non-root containers.
#
# `apk upgrade` is run here (intentionally divergent from the local Dockerfile,
# which skips it for reproducibility) so CI images built for prod pick up
# Alpine's published security patches at every build. Reproducibility is traded
# for hygiene on the prod image surface.
#
# APK_BUST is a cache-busting build arg that ensures this layer is never
# served from Docker's layer cache. Without it, a cached `apk upgrade`
# layer ships outdated OS packages with known CVEs even when Alpine has
# published fixes. Pass `--build-arg APK_BUST=$(date +%s)` in CI.

ARG APK_BUST=stable

RUN : "${APK_BUST}" \
 && apk upgrade --no-cache \
 && apk add --no-cache tini \
 && addgroup -g 10001 -S appgroup \
 && adduser -u 10001 -S appuser -G appgroup

# Copy the extracted layers in dependency order.
#
# BuildKit's --link avoids unnecessary filesystem copies between layers,
# reducing build I/O while allowing better layer reuse.
#
# Lower layers (framework dependencies) change infrequently and therefore stay
# cached across most builds, while application classes occupy the top layer and
# are rebuilt most often.

COPY --link --from=extractor --chown=10001:10001 /app/extracted/dependencies/ ./
COPY --link --from=extractor --chown=10001:10001 /app/extracted/spring-boot-loader/ ./
COPY --link --from=extractor --chown=10001:10001 /app/extracted/snapshot-dependencies/ ./
COPY --link --from=extractor --chown=10001:10001 /app/extracted/application/ ./

# Build a JVM Class Data Sharing (CDS) archive.
#
# Uses PropertiesLauncher with -Dloader.main to delegate to
# CdsTrainingApplication (com.example.cdstraining), which sits outside the
# production component-scan hierarchy and explicitly excludes auto-configuration
# requiring external infrastructure (database, OTLP collector, etc.), so this
# runs successfully during Docker build before any containers are started.
#
# PropertiesLauncher is used instead of JarLauncher because it supports the
# loader.main property for specifying an alternative main class.
#
# Disable components that are irrelevant during CDS training to keep the
# startup minimal and fast:
#   - spring.cache.type=redis                : Instantiate RedisCacheManager so its
#                                              classes (and the JSON serializer graph)
#                                              are baked into the CDS archive. No real
#                                              Redis connection is opened: Lettuce is
#                                              lazy and the context exits at refresh.
#   - management.otlp.tracing.export.enabled=false : Don't attempt OTLP export
#   - app.cds-training=true                  : Skips the admin-user CommandLineRunner
#
# spring.context.exit=onRefresh terminates the application immediately after
# the Spring context has fully initialized, allowing CDS to observe a complete
# startup without leaving a server running during the Docker build.
#
# NOTE:
#
# The CDS archive is generated during image build, not container startup. This
# intentionally shifts startup work left into the build pipeline so every
# deployed container benefits from faster cold starts without paying the CDS
# training cost repeatedly.

RUN java -XX:ArchiveClassesAtExit=application.jsa \
         -Dloader.main=com.example.cdstraining.CdsTrainingApplication \
         -Dspring.context.exit=onRefresh \
         -Dapp.cds-training=true \
         -Dspring.flyway.enabled=false \
         -Dspring.cache.type=redis \
         -Dmanagement.tracing.enabled=false \
         -Dmanagement.otlp.tracing.export.enabled=false \
         -Dotel.sdk.disabled=true \
         org.springframework.boot.loader.launch.PropertiesLauncher \
    && test -s application.jsa \
    && chown 10001:10001 application.jsa

USER 10001:10001

EXPOSE 8080

# =========================================================================================
# JVM TUNING — image- vs deployment-owned flags
#
# JVM sizing (heap, off-heap caps, GC behavioral tuning, AlwaysPreTouch) is owned
# by the DEPLOYMENT via JAVA_TOOL_OPTIONS, not the image. The image CMD carries
# only flags that must hold in every environment:
#
#   -XX:SharedArchiveFile=application.jsa: CDS archive generated at build time.
#   -Xshare:auto                         : Use the CDS archive when compatible.
#   -XX:+ExitOnOutOfMemoryError          : Safety invariant — fail fast on OOM.
#
# Heap / direct / metaspace sizing + GC tuning live in:
#   - homelab/TF/gitops/.../backend.yaml JAVA_TOOL_OPTIONS (prod)
#
# Setting sizing flags here would silently win over JAVA_TOOL_OPTIONS (JVM
# "last-wins" precedence for non-sticky flags) and recreate the precedence bug
# where the deployment's tuning was a no-op. Keep this CMD sizing-agnostic.
#
# Garbage collector: no collector is selected explicitly — JDK 21 defaults to G1GC,
# the right choice for a latency-sensitive request/response service. Operators
# override via JAVA_TOOL_OPTIONS in the deployment if a different collector is
# ever warranted.
# =========================================================================================

# Run the JVM under tini.
#
# ENTRYPOINT fixes the executable chain:
#
#     tini → java
#
# while CMD supplies the default JVM options and the application's main class.
#
# Keeping them separate allows operators to override JVM arguments (or even the
# main class) at `docker run` time without replacing the process supervisor
# (tini), ensuring correct signal forwarding and child-process reaping.

ENTRYPOINT ["/sbin/tini", "--", "java"]

CMD [ \
    "-XX:+ExitOnOutOfMemoryError", \
    "-XX:SharedArchiveFile=application.jsa", \
    "-Xshare:auto", \
    "org.springframework.boot.loader.launch.JarLauncher" \
]
