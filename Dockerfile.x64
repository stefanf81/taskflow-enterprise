# syntax=docker/dockerfile:1

# Production Spring Boot / Java 21 image. The multi-platform index pins the JVM
# release for native extraction and target-architecture CDS training/runtime.
# Renovate can update this digest while retaining the project's Java 21 policy.
# Explicit -resolute (Ubuntu 26.04 LTS, glibc) because the floating 21-jre tag
# tracks the current Ubuntu release and would drift silently.
ARG JAVA_IMAGE=eclipse-temurin:21-jre-resolute@sha256:ab0b2cdb24a65f299d6968601789826da34e4fbf6baa0518739ab8463f08779f
ARG PLATFORM=linux/amd64

# JAR extraction is architecture-independent: run natively on Apple Silicon as
# well as amd64 CI. Compilation is performed by Gradle before the Docker build.
FROM --platform=$BUILDPLATFORM ${JAVA_IMAGE} AS extractor
WORKDIR /app

# build.gradle disables the plain jar; this must match exactly one bootJar.
COPY build/libs/*.jar application.jar

# The default layout creates a small application.jar with a manifest Class-Path
# pointing to lib/. Standard JVM class loading makes this layout CDS-friendly.
RUN --network=none java -Djarmode=tools -jar application.jar \
    extract --layers --destination extracted

# CDS is architecture/JVM-specific. Share the exact target JRE and identity;
# package refreshes are confined to the runtime stage so they do not retrain CDS.
# No --system for useradd: a --system account expects UID < 1000 and emits a
# warning for the explicit 10001; without it shadow still locks the password.
FROM --platform=$PLATFORM ${JAVA_IMAGE} AS java-base
WORKDIR /app
RUN groupadd --system --gid 10001 appgroup \
    && useradd --uid 10001 --gid 10001 --no-create-home \
         --shell /usr/sbin/nologin appuser

FROM java-base AS cds-training

# Match runtime paths, contents, and JAR timestamps for CDS classpath validation.
COPY --link --from=extractor --chown=0:0 /app/extracted/dependencies/ ./
COPY --link --from=extractor --chown=0:0 /app/extracted/spring-boot-loader/ ./
COPY --link --from=extractor --chown=0:0 /app/extracted/snapshot-dependencies/ ./
COPY --link --from=extractor --chown=0:0 /app/extracted/application/ ./

USER 10001:10001

# The dedicated training context initializes cache/serialization classes and
# exits at refresh. Network isolation enforces its infrastructure-free contract.
# -cp application.jar honors the same manifest Class-Path as runtime's -jar,
# while selecting the training main directly. Only the archive is published.
RUN --network=none java -XX:ArchiveClassesAtExit=/tmp/application.jsa \
         -Dspring.context.exit=onRefresh \
         -Dapp.cds-training=true \
         -Dspring.flyway.enabled=false \
         -Dspring.cache.type=redis \
         -Dotel.sdk.disabled=true \
         -cp application.jar com.example.cdstraining.CdsTrainingApplication \
    && test -s /tmp/application.jsa

FROM java-base AS runtime

# CI changes APT_BUST on every build to obtain Ubuntu package fixes. This keeps
# the JVM base pinned, but package resolution intentionally remains build-time.
# Temurin's JRE lives in /opt/java/openjdk and is not managed by dpkg.
# tini installs to /usr/bin/tini on the Ubuntu-based Temurin image.
ARG APT_BUST=stable
RUN : "${APT_BUST}" \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get -y upgrade \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/*

# Stable dependencies first; root-owned application files are readable but not
# writable by the runtime user, including outside a read-only deployment.
COPY --link --from=extractor --chown=0:0 /app/extracted/dependencies/ ./
COPY --link --from=extractor --chown=0:0 /app/extracted/spring-boot-loader/ ./
COPY --link --from=extractor --chown=0:0 /app/extracted/snapshot-dependencies/ ./
COPY --link --from=extractor --chown=0:0 /app/extracted/application/ ./
COPY --link --from=cds-training --chown=0:0 --chmod=0444 /tmp/application.jsa ./application.jsa

USER 10001:10001

# Validate the archive after package refresh, under the final identity and
# classpath. Fail the build on incompatibility; production retains CDS fallback.
# Temporary JVM files from this check do not become part of the runtime image.
RUN --network=none --mount=type=tmpfs,target=/tmp \
    java -Xshare:on -XX:SharedArchiveFile=application.jsa \
         -Xlog:cds=info -cp application.jar -version

EXPOSE 8080

# Kubernetes owns production probes. Deployment JAVA_TOOL_OPTIONS owns heap,
# off-heap, GC, and diagnostics (homelab/TF/gitops/apps/taskflow/backend.yaml).
# Keep CMD sizing-agnostic so image arguments cannot override that tuning.
# tini forwards shutdown signals and reaps children; exec-form CMD starts Java
# directly with the extracted application JAR, not the original executable JAR.
ENTRYPOINT ["/usr/bin/tini", "--", "java"]
CMD [ \
    "-XX:+ExitOnOutOfMemoryError", \
    "-XX:SharedArchiveFile=application.jsa", \
    "-Xshare:auto", \
    "-jar", \
    "application.jar" \
]
