# TaskFlow local environment
#
# This file is consumed by docker-compose.yml. Do not use the placeholder
# values unchanged: Compose runs the backend with the prod profile, which
# requires a persistent RSA key pair.

# Database Configuration
POSTGRES_DB=taskflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# Application Security
SPRING_SECURITY_PASSWORD=<CHANGE_ME_STRONG_TOKEN_SECRET>

# CORS Allowed Origins (comma-separated). State-changing POST/PUT carry an
# Origin header that Spring checks against this list; set to your real
# production frontend origin(s). docker-compose defaults to both loopback
# hostnames so the local E2E stack passes regardless of access URL.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Persistent JWT RSA Signing Keys (single-line Base64-encoded DER)
# Compose requires both values because it runs the prod profile. Generate a
# PKCS#8 private key and an X.509 public key from the repository root:
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#     -outform DER -out private.der
#   openssl pkey -inform DER -in private.der -pubout -outform DER \
#     | base64 | tr -d '\n' > public.b64
#   base64 < private.der | tr -d '\n' > private.b64
#
# Paste the contents of private.b64 and public.b64 below. Delete the DER and
# .b64 files after updating .env; they are private credentials.
APP_RSA_PRIVATE_KEY=<CHANGE_ME_BASE64_PRIVATE_KEY>
APP_RSA_PUBLIC_KEY=<CHANGE_ME_BASE64_PUBLIC_KEY>
