# Lockfile portability guard.
#
# Developer machines may resolve npm through a corporate Nexus mirror (global ~/.npmrc) and
# Maven through ~/.m2/settings.xml with a wildcard mirror. When that happens, `npm install`
# writes the internal host into every `resolved` URL in package-lock.json, which CI runners
# cannot reach, and that mirror has also served corrupted tarballs. Always resolve from the
# public registry so the committed lockfile stays installable everywhere.
registry=https://registry.npmjs.org/

# Retained from mobile: React 19 / Expo 58 tooling still declares narrower peer ranges.
# This applies to the whole workspace now that there is a single install.
legacy-peer-deps=true

# npm 12 defaults allow-remote to `none`. Regenerating the lockfile from scratch (Renovate's lock
# file maintenance) then fails with EALLOWREMOTE on @tailwindcss/oxide-wasm32-wasi, a transitive
# optional dependency, although its tarball is on the public registry; `root` is not enough. The
# committed lockfile still pins every URL and integrity, and `npm ci` installs only what it lists.
allow-remote=all
