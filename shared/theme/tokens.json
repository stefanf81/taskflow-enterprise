{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "TaskFlow Theme Tokens",
  "colors": {
    "obsidian": {
      "bg": "#090d16",
      "card": "#09090b",
      "surface": "#18181b",
      "border": "#27272a",
      "muted": "#1f1f22",
      "inputBg": "#000000",
      "dark": "#030712",
      "light": "#1e293b"
    },
    "gold": {
      "main": "#c5a059",
      "bright": "#d4af37",
      "light": "#e5c185",
      "dark": "#8e7a5c",
      "dim": "rgba(197, 160, 89, 0.15)",
      "border": "rgba(197, 160, 89, 0.3)",
      "tint": "#1a1610"
    },
    "text": {
      "primary": "#f4f4f5",
      "secondary": "#a1a1aa",
      "muted": "#8a8a93",
      "dark": "#090d16",
      "disabled": "#7e7e8a",
      "onAccent": "#000000",
      "white": "#ffffff"
    },
    "status": {
      "pending": "#fbbf24",
      "approved": "#34d399",
      "denied": "#f87171",
      "info": "#3B82F6",
      "deniedStrong": "#dc2626"
    }
  },
  "semantic": {
    "$comment": "Purpose names the app uses (Tailwind utilities such as bg-surface or text-accent, and var(--color-*) in CSS). Each value names a palette colour above, so the contrast rules keep applying.",
    "page": "obsidian.inputBg",
    "surface": "obsidian.card",
    "raised": "obsidian.surface",
    "border": "obsidian.border",
    "fg": "text.primary",
    "fg-strong": "text.white",
    "fg-muted": "text.secondary",
    "fg-subtle": "text.muted",
    "fg-disabled": "text.disabled",
    "on-accent": "text.onAccent",
    "accent": "gold.main",
    "accent-hover": "gold.bright",
    "accent-soft": "gold.light",
    "accent-muted": "gold.dark",
    "accent-tint": "gold.tint",
    "success": "status.approved",
    "warning": "status.pending",
    "danger": "status.denied",
    "danger-strong": "status.deniedStrong",
    "info": "status.info"
  },
  "radius": {
    "sm": "6px",
    "md": "8px",
    "lg": "12px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.5)",
    "ring": "0 0 0 1px rgba(255, 255, 255, 0.05)",
    "raised": "0 4px 6px -1px rgba(0, 0, 0, 0.5), 0 2px 4px -2px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.05)",
    "glow": "0 0 20px rgba(197, 160, 89, 0.15)"
  },
  "font": {
    "sans": "'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
  }
}
