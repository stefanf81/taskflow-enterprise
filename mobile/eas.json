{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "node": "26.13.0",
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "environment": "preview",
      "node": "26.13.0",
      "env": {
        "TASKFLOW_TLS_POLICY": "required",
        "EAS_USE_CACHE": "1",
        "EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH": "1",
        "EXPO_UNSTABLE_TREE_SHAKING": "1"
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "environment": "production",
      "node": "26.13.0",
      "env": {
        "TASKFLOW_TLS_POLICY": "required",
        "EAS_RESTORE_CACHE": "0",
        "EAS_SAVE_CACHE": "1"
      },
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}
