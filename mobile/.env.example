# TaskFlow Mobile — Environment Configuration
# Copy this file to .env and adjust for your setup.

# Backend API base URL for local development.
# - iOS Simulator: http://localhost:4200 (auto-detected when unset)
# - Android Emulator: http://10.0.2.2:4200 (auto-detected when unset)
# - Physical device: http://<YOUR_MACHINE_IP>:4200
# Production builds require EXPO_PUBLIC_API_URL to be an https:// URL. Set it
# through the EAS production environment; localhost fallback is development-only.
EXPO_PUBLIC_API_URL=http://localhost:4200

# Preview and production EAS builds require two comma-separated SHA-256 SPKI
# public-key hashes. These are consumed only during native prebuild.
# TASKFLOW_API_SPKI_PINS=base64-current-spki-hash=,base64-backup-spki-hash=
