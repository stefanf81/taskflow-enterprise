# TaskFlow Mobile — Environment Configuration
# Copy this file to .env and adjust for your setup.

# Backend API base URL
# - iOS Simulator: http://localhost:8080 (auto-detected)
# - Android Emulator: http://10.0.2.2:8080 (auto-detected)
# - Physical device: http://<YOUR_MACHINE_IP>:8080 (REQUIRED for physical devices)
#   Find your IP with: ifconfig | grep "inet " | grep -v 127.0.0.1
EXPO_PUBLIC_API_URL=http://localhost:8080
