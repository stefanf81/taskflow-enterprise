{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "TaskFlow Cross-Platform Feature Mapping Matrix",
  "description": "Used by AI agents and developer workflows to map features between Web Frontend (@frontend/) and Mobile App (@mobile/).",
  "mappings": [
    {
      "feature": "Stylist Card & Profiles",
      "webComponent": "frontend/src/app/features/booking/stylist-card/stylist-card.ts",
      "mobileComponent": "mobile/src/features/booking/StylistCard.tsx",
      "storeHook": {
        "web": "frontend/src/app/features/booking/public-barber.store.ts",
        "mobile": "mobile/src/core/barbers/useBarbers.ts"
      }
    },
    {
      "feature": "Lookbook & Style Showcase",
      "webComponent": "frontend/src/app/features/landing/lookbook/lookbook.ts",
      "mobileComponent": "mobile/src/features/landing/LookbookScreen.tsx",
      "mobileSubComponent": "mobile/src/features/landing/LookbookGallery.tsx"
    },
    {
      "feature": "Booking Wizard & Slot Picker",
      "description": "4-step wizard: Treatment \u2192 Stylist \u2192 Date/Slot \u2192 Contact (aligned across both platforms)",
      "webComponent": "frontend/src/app/features/booking/booking-wizard.ts",
      "webTemplate": "frontend/src/app/features/booking/booking-wizard.html",
      "mobileComponent": "mobile/src/features/booking/BookingScreen.tsx",
      "webSteps": [
        "frontend/src/app/features/booking/steps/service-step.ts",
        "frontend/src/app/features/booking/steps/stylist-step.ts",
        "frontend/src/app/features/booking/steps/date-time-step.ts",
        "frontend/src/app/features/booking/steps/contact-step.ts"
      ],
      "mobileSteps": [
        "mobile/src/features/booking/ServiceStep.tsx",
        "mobile/src/features/booking/StylistStep.tsx",
        "mobile/src/features/booking/DateTimeStep.tsx",
        "mobile/src/features/booking/ContactStep.tsx"
      ],
      "mobileSubComponents": [
        "mobile/src/features/booking/BookingHeader.tsx",
        "mobile/src/features/booking/StepNavigation.tsx",
        "mobile/src/features/booking/TimeSlotPicker.tsx",
        "mobile/src/features/booking/ReceiptModal.tsx"
      ],
      "calendarRules": {
        "web": "frontend/src/app/features/booking/booking-calendar.ts",
        "mobile": "mobile/src/features/booking/bookingWizard.ts"
      },
      "storeHook": {
        "web": "frontend/src/app/features/booking/booking.store.ts",
        "mobile": "mobile/src/features/booking/useBookingWizard.ts"
      },
      "mobileQueryHooks": [
        "mobile/src/core/appointments/useAppointments.ts"
      ]
    },
    {
      "feature": "Customer Portal & History",
      "webComponent": "frontend/src/app/features/customer/customer-portal.ts",
      "webTemplate": "frontend/src/app/features/customer/customer-portal.html",
      "mobileComponent": "mobile/src/features/customer/CustomerPortalScreen.tsx",
      "storeHook": {
        "web": "frontend/src/app/core/customer/customer.store.ts",
        "mobile": "mobile/src/features/customer/useCustomer.ts"
      }
    },
    {
      "feature": "Admin Dashboard & Management",
      "webComponent": "frontend/src/app/features/admin/admin-dashboard.ts",
      "webTemplate": "frontend/src/app/features/admin/admin-dashboard.html",
      "mobileComponent": "mobile/src/features/admin/AdminDashboardScreen.tsx",
      "storeHook": {
        "web": "frontend/src/app/features/admin/appointment.store.ts",
        "mobile": "mobile/src/core/appointments/useAppointments.ts"
      },
      "webTabs": [
        "frontend/src/app/features/admin/admin-appointments-tab.ts",
        "frontend/src/app/features/admin/admin-services-tab.ts",
        "frontend/src/app/features/admin/admin-schedules-tab.ts",
        "frontend/src/app/features/admin/admin-notifications-tab.ts"
      ]
    },
    {
      "feature": "Admin Service Catalog Management",
      "webComponent": "frontend/src/app/features/admin/admin-services-tab.ts",
      "mobileComponent": "mobile/src/features/admin/AdminCatalogScreen.tsx",
      "storeHook": {
        "web": "frontend/src/app/core/catalog/service-catalog.store.ts",
        "mobile": "mobile/src/core/catalog/useCatalog.ts"
      }
    },
    {
      "feature": "Admin Staff Schedules & Time Off",
      "webComponent": "frontend/src/app/features/admin/admin-schedules-tab.ts",
      "mobileComponent": "mobile/src/features/admin/AdminSchedulesScreen.tsx",
      "storeHook": {
        "web": "frontend/src/app/features/admin/barber.store.ts",
        "mobile": "mobile/src/core/barbers/useBarbers.ts"
      }
    },
    {
      "feature": "Admin Notification Outbox",
      "webComponent": "frontend/src/app/features/admin/admin-notifications-tab.ts",
      "mobileComponent": "mobile/src/features/admin/AdminNotificationsScreen.tsx",
      "storeHook": {
        "web": "frontend/src/app/features/admin/notification.store.ts",
        "mobile": "mobile/src/features/admin/useNotifications.ts"
      }
    },
    {
      "feature": "Public Guest Cancellation & Reviews",
      "webComponent": "frontend/src/app/features/landing/post-booking-actions/post-booking-actions.ts",
      "mobileComponent": "mobile/src/features/landing/PublicActionsScreen.tsx",
      "mobileCancelModal": "mobile/src/features/landing/PublicCancelModal.tsx",
      "mobileReviewModal": "mobile/src/features/landing/PublicReviewModal.tsx",
      "storeHook": {
        "web": "frontend/src/app/core/reviews/review.store.ts",
        "mobile": "mobile/src/features/landing/useReviews.ts"
      }
    },
    {
      "feature": "Auth & Login Modal",
      "webComponent": "frontend/src/app/features/landing/auth-modal/auth-modal.ts",
      "mobileComponent": "mobile/src/features/auth/LoginScreen.tsx",
      "mobileRegister": "mobile/src/features/auth/RegisterScreen.tsx",
      "storeHook": {
        "web": "frontend/src/app/core/auth/auth.state.ts",
        "mobile": "mobile/src/core/auth/useAuthStore.ts"
      }
    },
    {
      "feature": "Landing Page",
      "webComponent": "frontend/src/app/features/landing/landing-page.ts",
      "webTemplate": "frontend/src/app/features/landing/landing-page.html",
      "mobileComponent": "mobile/src/features/landing/HomeScreen.tsx",
      "mobileSections": [
        "mobile/src/features/landing/AnnouncementBar.tsx",
        "mobile/src/features/landing/HomeHeader.tsx",
        "mobile/src/features/landing/HeroSection.tsx",
        "mobile/src/features/landing/HomeSection.tsx",
        "mobile/src/features/landing/GroomingMenu.tsx",
        "mobile/src/features/landing/ShopInfo.tsx",
        "mobile/src/features/landing/MasterStylists.tsx",
        "mobile/src/features/landing/FaqSection.tsx"
      ],
      "notes": "Web renders most sections inline in landing-page.html; mobile has one component per section (the grooming menu card holds GroomingMenu plus the ShopInfo panels)."
    },
    {
      "feature": "FAQ Section",
      "webComponent": "frontend/src/app/features/landing/faq-section/faq-section.ts",
      "mobileComponent": "mobile/src/features/landing/FaqSection.tsx"
    },
    {
      "feature": "Announcement Bar",
      "webComponent": "frontend/src/app/features/landing/announcement-bar/announcement-bar.ts",
      "mobileComponent": "mobile/src/features/landing/AnnouncementBar.tsx"
    },
    {
      "feature": "Receipt Modal (Booking Confirmation)",
      "webComponent": "frontend/src/app/features/booking/receipt-modal/receipt-modal.ts",
      "mobileComponent": "mobile/src/features/booking/ReceiptModal.tsx"
    },
    {
      "feature": "Flash Messages (alert banners)",
      "webComponent": "frontend/src/app/core/ui/flash-messages.ts",
      "mobileComponent": "mobile/src/components/common/useFlashMessage.ts",
      "notes": "Web: one app-wide service, the error stays until dismissed. Mobile: one hook per screen (customer portal, admin dashboard, public actions), success and error both auto-dismiss."
    },
    {
      "feature": "Shop Clock & Rules",
      "notes": "Time zone, booking window and opening hours from GET /api/v1/appointments/public/shop; the rules themselves (opening days, window, cancellable bookings, time helpers) live in shared/domain (@taskflow/domain).",
      "storeHook": {
        "web": "frontend/src/app/core/shop-clock.ts",
        "mobile": "mobile/src/core/shop/useShopInfo.ts"
      }
    }
  ],
  "platformContracts": {
    "webApiTypes": "frontend/src/app/types/api.ts",
    "mobileApiTypes": "mobile/src/types/api.ts",
    "webThemeTokens": "frontend/src/theme/tokens.json",
    "mobileThemeTokens": "mobile/src/theme/tokens.json",
    "webTimeUtils": "frontend/src/app/core/time-utils.ts",
    "mobileTimeUtils": "mobile/src/utils/time-utils.ts"
  }
}
