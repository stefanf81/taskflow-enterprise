{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "customConditions": [],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.spec.tsbuildinfo"
  },
  "include": [
    "*.ts",
    "*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx"
  ],
  "exclude": [
    "node_modules/**",
    "android/**",
    "ios/**"
  ]
}
