{
  "name": "taskflow-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "npm run test:security && jest",
    "test:security": "node --test \"test/security/**/*.test.cjs\"",
    "test:watch": "jest --watch",
    "e2e:build": "detox build --configuration ios.sim.release",
    "e2e:test": "detox test --configuration ios.sim.release",
    "e2e:build:android": "detox build --configuration android.emu.release",
    "e2e:test:android": "detox test --configuration android.emu.release",
    "lint": "tsc --noEmit",
    "check:eas": "node scripts/check-eas-config.cjs",
    "build:android": "npm run check:eas && eas build --platform android",
    "build:ios": "npm run check:eas && eas build --platform ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^6.0.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@tanstack/react-query": "^5.104.0",
    "@taskflow/schemas": "file:../shared/schemas",
    "axios": "^1.19.0",
    "expo": "~58.0.17",
    "expo-build-properties": "~58.0.10",
    "expo-crypto": "~58.0.6",
    "expo-font": "~58.0.8",
    "expo-network": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@jest/types": "^30.5.1",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "~19.3.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "detox": "^20.51.4",
    "expo-detox-config-plugin": "^13.1.0",
    "expo-doctor": "^1.20.4",
    "jest": "~30.5.0",
    "jest-expo": "~58.0.12",
    "msw": "^3.0.2",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "braces": "file:vendor/braces-3.0.3-patched.tgz",
    "node-forge": "file:vendor/node-forge-1.4.0-patched.tgz",
    "postcss": "8.5.31",
    "fast-uri": "3.1.9",
    "uuid": "11.1.1",
    "@xmldom/xmldom": "0.8.15",
    "brace-expansion": "5.0.12",
    "nanoid": "3.3.20",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "5.5.0"
    }
  },
  "allowScripts": {
    "detox": true,
    "dtrace-provider": true,
    "fsevents": true,
    "msw": true
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest",
        "@jest/types"
      ]
    }
  }
}
