{
  "expo": {
    "name": "TaskFlow Mobile",
    "slug": "taskflow-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "updates": {
      "enabled": false
    },
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskflow.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F11"
      },
      "package": "com.taskflow.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidSplashApiFix",
      "./plugins/withTaskflowTlsPinning",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F0F11"
        }
      ],
      "expo-secure-store",
      [
        "expo-detox-config-plugin",
        {
          "skipProguard": true
        }
      ],
      "./plugins/withDetoxProguardRules",
      "expo-font",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "gifEnabled": false,
            "webpEnabled": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "11111111-2222-3333-4444-555555555555"
      }
    }
  }
}
