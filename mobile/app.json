{
  "expo": {
    "name": "TaskFlow Mobile",
    "slug": "taskflow-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskflow.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "TaskFlow requires camera access to scan booking QR codes or take profile pictures.",
        "NSFaceIDUsageDescription": "TaskFlow uses Face ID for fast and secure staff and customer login."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F11"
      },
      "package": "com.taskflow.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F0F11"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow TaskFlow to use Face ID for fast authentication."
        }
      ],
      "@config-plugins/detox"
    ],
    "extra": {
      "apiUrl": "http://localhost:8080",
      "eas": {
        "projectId": "11111111-2222-3333-4444-555555555555"
      }
    }
  }
}
