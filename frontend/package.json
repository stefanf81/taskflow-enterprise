{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "build": "ng build",
    "lint": "node scripts/generate-theme.mjs --check && eslint . && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:docker": "bash -c 'cd .. && trap \"$(pwd)/stop-docker.sh\" EXIT && APP_RATE_LIMIT_AUTH_MAX_REQUESTS_PER_MINUTE=${APP_RATE_LIMIT_AUTH_MAX_REQUESTS_PER_MINUTE:-200} ./start-docker.sh && cd frontend && E2E_DOCKER=true playwright test'",
    "theme:build": "node scripts/generate-theme.mjs",
    "theme:check": "node scripts/generate-theme.mjs --check"
  },
  "private": true,
  "packageManager": "npm@12.2.0",
  "overrides": {
    "esbuild": "0.28.2",
    "fast-uri": "3.1.8"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@taskflow/schemas": "file:../shared/schemas",
    "rxjs": "~7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true,
    "lmdb": true,
    "msgpackr-extract": true
  }
}
