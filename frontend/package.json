{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "build": "ng build",
    "lint": "node scripts/generate-theme.mjs --check && eslint . && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:docker": "bash -c 'cd .. && APP_RATE_LIMIT_AUTH_MAX_REQUESTS_PER_MINUTE=${APP_RATE_LIMIT_AUTH_MAX_REQUESTS_PER_MINUTE:-200} ./start-docker.sh && trap ./stop-docker.sh EXIT && cd frontend && playwright test'",
    "theme:build": "node scripts/generate-theme.mjs",
    "theme:check": "node scripts/generate-theme.mjs --check"
  },
  "private": true,
  "packageManager": "npm@12.1.0",
  "overrides": {
    "esbuild": "0.28.2",
    "@babel/core": "7.29.7",
    "fast-uri": "3.1.8",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.8"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@taskflow/schemas": "file:../shared/schemas",
    "rxjs": "~7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true,
    "lmdb": true,
    "msgpackr-extract": true
  }
}
