{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1",
    "format": "prettier --write --cache --cache-location node_modules/.cache/prettier/scripts .",
    "format:check": "prettier --check --cache --cache-location node_modules/.cache/prettier/scripts .",
    "build": "ng build",
    "lint": "node scripts/generate-theme.mjs --check && eslint --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content . && tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/app.tsbuildinfo -p tsconfig.app.json && tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/spec.tsbuildinfo -p tsconfig.spec.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:docker": "bash -c 'cd .. && trap \"$(pwd)/stop-docker.sh\" EXIT && APP_RATE_LIMIT_AUTH_MAX_REQUESTS_PER_MINUTE=${APP_RATE_LIMIT_AUTH_MAX_REQUESTS_PER_MINUTE:-200} ./start-docker.sh && cd frontend && E2E_DOCKER=true playwright test'",
    "theme:build": "node scripts/generate-theme.mjs",
    "theme:check": "node scripts/generate-theme.mjs --check"
  },
  "private": true,
  "packageManager": "npm@12.2.2",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-server": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/ssr": "^22.2.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@taskflow/domain": "*",
    "@taskflow/schemas": "*",
    "rxjs": "~7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.32",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.3"
  }
}
