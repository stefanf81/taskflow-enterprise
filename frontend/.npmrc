# Lockfile portability guard.
#
# Developer machines may resolve npm through a corporate Nexus mirror (global
# ~/.npmrc) and Maven through ~/.m2/settings.xml with a wildcard mirror. When
# that happens, `npm install` writes the internal host into every `resolved`
# URL in package-lock.json — which CI runners cannot reach.
#
# Always resolve this project's dependencies from the public registry so the
# committed lockfile stays installable everywhere (same convention as ../mobile).
registry=https://registry.npmjs.org/
