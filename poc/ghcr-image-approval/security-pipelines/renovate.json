{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "enabledManagers": [
    "dockerfile"
  ],
  "includePaths": [
    "catalog/**"
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/^catalog\\/Dockerfile\\.temurin$/"
    ]
  },
  "packageRules": [
    {
      "description": "Tag changes (e.g. Java 21 -> 25) need a new manually bootstrapped baseline; only digest updates flow through the approval pipeline.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false
    }
  ]
}
