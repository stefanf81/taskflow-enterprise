{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "enabledManagers": [
    "dockerfile"
  ],
  "packageRules": [
    {
      "description": "Consume only base images already promoted and signed in GHCR",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^ghcr\\.io\\/example-org\\/approved\\//"
      ],
      "automerge": false
    }
  ]
}
