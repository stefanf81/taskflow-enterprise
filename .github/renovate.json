{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    "abandonments:recommended",
    ":maintainLockFilesWeekly"
  ],
  "branchPrefix": "renovate/",
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "gitAuthor": "stefanf81 <17823566+stefanf81@users.noreply.github.com>",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "branchConcurrentLimit": 10,
  "postUpdateOptions": ["npmDedupe"],
  "vulnerabilityAlerts": {
    "labels": ["security", "dependencies"],
    "minimumReleaseAge": null
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "Automerge patch, pin, and digest updates after required CI checks pass and a 3-day soak window",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "Minor updates require manual review; hold 3 days to catch immediate regressions",
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "3 days",
      "automerge": false
    },
    {
      "description": "Delay major updates so the ecosystem (Expo SDK, jest-expo, msw, babel presets) can add support first; never automerge majors",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "30 days",
      "automerge": false
    },
    {
      "description": "Keep npm overrides exact so npm lockfile updates do not fail with EOVERRIDE",
      "matchManagers": ["npm"],
      "matchDepTypes": ["overrides"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Keep fast-uri on the compatible 3.x release line",
      "matchManagers": ["npm"],
      "matchPackageNames": ["fast-uri"],
      "allowedVersions": "/^3\\./"
    },
    {
      "description": "Mobile overrides are pinned to toolchain-compatible releases: uuid 14 and nanoid 6 are ESM-only and break the current Expo/Metro/jest pipeline, and the nested js-yaml override guards @istanbuljs/load-nyc-config. Revisit after the Expo SDK upgrade.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["uuid", "nanoid", "js-yaml"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Defer Node.js and npm major upgrades until the Expo SDK upgrade validates the native toolchain against the new runtime (mobile/.nvmrc and the workflow NODE_VERSION are pinned to 22).",
      "matchPackageNames": ["node", "npm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Frontend pins @babel/core 7.x; a Babel 8 major is not validated against the Angular 22 build toolchain yet. Revisit with the next Angular upgrade.",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/package.json"],
      "matchPackageNames": ["@babel/core"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Runner images are pinned deliberately (ubuntu-24.04) for reproducible native/CI behaviour; ubuntu-latest is migrated by GitHub itself. Do not auto-bump the runner major.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["ubuntu"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Exclude only the named direct dependencies managed by the installed Expo SDK",
      "matchManagers": ["npm"],
      "matchFileNames": ["mobile/package.json"],
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "react",
        "react-dom",
        "react-native",
        "react-native-web",
        "react-native-safe-area-context",
        "react-native-screens",
        "@react-native/*",
        "jest-expo",
        "react-test-renderer"
      ],
      "enabled": false
    },
    {
      "description": "Keep React types aligned with React 19 in mobile",
      "matchManagers": ["npm"],
      "matchFileNames": ["mobile/package.json"],
      "matchPackageNames": ["@types/react", "@types/react-dom"],
      "allowedVersions": "/^19\\./"
    },
    {
      "description": "Expo SDK 57's plist parser omits the MIME type required by @xmldom/xmldom 0.9",
      "matchManagers": ["npm"],
      "matchFileNames": ["mobile/package.json"],
      "matchPackageNames": ["@xmldom/xmldom"],
      "allowedVersions": "/^0\\.8\\./"
    },
    {
      "description": "Keep Temurin runtime images on Java 21",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["eclipse-temurin"],
      "allowedVersions": "/^21-/"
    },
    {
      "description": "Keep Alpine runtime images on the 3.24 release line",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alpine"],
      "allowedVersions": "/^3\\.24\\./"
    },
    {
      "description": "Keep PostgreSQL container images on version 18 to avoid incompatible data directory upgrades",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "allowedVersions": "/^18\\./"
    },
    {
      "description": "Keep TypeScript on major version 6",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "/^6\\./"
    },
    {
      "description": "Keep Vitest on the Angular 22-compatible 4.x release line",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/package.json"],
      "matchPackageNames": ["vitest", "@vitest/coverage-v8"],
      "allowedVersions": "/^4\\./"
    },
    {
      "description": "Update the Angular framework and its compatible toolchain together",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/package.json"],
      "matchPackageNames": ["@angular/**", "rxjs", "typescript"],
      "groupName": "Angular framework and toolchain"
    },
    {
      "description": "Keep Tailwind CSS and PostCSS plugin aligned",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/package.json"],
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**"],
      "groupName": "Tailwind CSS"
    },
    {
      "description": "Keep Zod aligned across web, mobile, and shared schemas",
      "matchManagers": ["npm"],
      "matchPackageNames": ["zod"],
      "groupName": "Zod validation"
    },
    {
      "description": "Keep the Spring Boot plugin and dependency BOM aligned",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "org.springframework.boot",
        "org.springframework.boot:spring-boot-dependencies"
      ],
      "groupName": "Spring Boot plugin and BOM"
    },
    {
      "description": "Flyway core and its PostgreSQL module must use the same release",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "org.flywaydb:flyway-core",
        "org.flywaydb:flyway-database-postgresql"
      ],
      "groupName": "Flyway PostgreSQL support"
    },
    {
      "description": "Hibernate core and JCache integration are version-coupled",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "org.hibernate.orm:hibernate-core",
        "org.hibernate.orm:hibernate-jcache"
      ],
      "groupName": "Hibernate core and JCache"
    },
    {
      "description": "Keep the Netty BOM and explicit DNS codec pin aligned",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["io.netty:netty-bom", "io.netty:netty-codec-dns"],
      "groupName": "Netty BOM and DNS codec"
    },
    {
      "description": "Keep Log4j API and its SLF4J bridge on the same release",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["org.apache.logging.log4j:log4j-*"],
      "groupName": "Log4j API and SLF4J bridge"
    },
    {
      "description": "Keep Jackson 2 security pins and BOM aligned",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["com.fasterxml.jackson:**"],
      "groupName": "Jackson 2 dependencies"
    },
    {
      "description": "Keep Jackson 3 security pins and BOM aligned",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["tools.jackson:**"],
      "groupName": "Jackson 3 dependencies"
    },
    {
      "description": "Keep Tomcat embedded dependencies aligned",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["org.apache.tomcat.embed:**"],
      "groupName": "Tomcat embedded dependencies"
    },
    {
      "description": "Keep OpenTelemetry modules and semconv aligned",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "io.opentelemetry:**",
        "io.opentelemetry.semconv:**"
      ],
      "groupName": "OpenTelemetry"
    },
    {
      "description": "Keep Testcontainers modules aligned",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["org.testcontainers:**"],
      "groupName": "Testcontainers"
    },
    {
      "description": "Keep Byte Buddy modules aligned",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["net.bytebuddy:**"],
      "groupName": "Byte Buddy"
    },
    {
      "description": "Keep SLF4J modules aligned",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["org.slf4j:**"],
      "groupName": "SLF4J"
    },
    {
      "description": "React Navigation packages share React Native peer-dependency constraints",
      "matchManagers": ["npm"],
      "matchFileNames": ["mobile/package.json"],
      "matchPackageNames": ["@react-navigation/**"],
      "groupName": "React Navigation"
    },
    {
      "description": "Keep native test tooling aligned with its React Native compatibility requirements",
      "matchManagers": ["npm"],
      "matchFileNames": ["mobile/package.json"],
      "matchPackageNames": [
        "expo-detox-config-plugin",
        "@testing-library/react-native",
        "detox"
      ],
      "groupName": "React Native test tooling"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Blocked on Expo SDK upgrade: @babel/core 8 / jest 30 / @types/jest 30 / @jest/types 30 require babel-preset-expo & jest-expo versions that do not yet support these majors (Babel 8 loadPartialConfig break vs msw; jest-expo still pins the @jest/* 29 surface). Fully suppressed: no branch, no PR, dashboard-only until this rule is removed after the SDK upgrade.",
      "matchManagers": ["npm"],
      "matchFileNames": ["mobile/package.json"],
      "matchPackageNames": ["@babel/core", "jest", "@types/jest", "@jest/types"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "groupName": "Blocked on Expo SDK upgrade"
    }
  ]
}
