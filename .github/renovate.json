{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "branchPrefix": "renovate/",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "gitAuthor": "stefanf81 <17823566+stefanf81@users.noreply.github.com>",
  "packageRules": [
    {
      "description": "Automerge patch and minor updates after required CI checks pass",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Keep npm overrides exact so npm lockfile updates do not fail with EOVERRIDE",
      "matchManagers": ["npm"],
      "matchDepTypes": ["overrides"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Exclude only the named direct dependencies managed by the installed Expo SDK",
      "matchManagers": ["npm"],
      "matchFileNames": ["mobile/package.json"],
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "react",
        "react-dom",
        "react-native",
        "react-native-web",
        "react-native-safe-area-context",
        "react-native-screens",
        "@react-native/*",
        "jest-expo",
        "react-test-renderer"
      ],
      "enabled": false
    },
    {
      "description": "Expo SDK 57's plist parser omits the MIME type required by @xmldom/xmldom 0.9",
      "matchManagers": ["npm"],
      "matchFileNames": ["mobile/package.json"],
      "matchPackageNames": ["@xmldom/xmldom"],
      "allowedVersions": "/^0\\.8\\./"
    },
    {
      "description": "Keep Temurin runtime images on Java 21",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["eclipse-temurin"],
      "allowedVersions": "/^21-/"
    },
    {
      "description": "Keep TypeScript on major version 6",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "/^6\\./"
    },
    {
      "description": "Update the Angular framework and its compatible toolchain together",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/package.json"],
      "matchPackageNames": ["@angular/**", "rxjs", "typescript"],
      "groupName": "Angular framework and toolchain"
    },
    {
      "description": "Keep the Spring Boot plugin and dependency BOM aligned",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "org.springframework.boot",
        "org.springframework.boot:spring-boot-dependencies"
      ],
      "groupName": "Spring Boot plugin and BOM"
    },
    {
      "description": "Flyway core and its PostgreSQL module must use the same release",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "org.flywaydb:flyway-core",
        "org.flywaydb:flyway-database-postgresql"
      ],
      "groupName": "Flyway PostgreSQL support"
    },
    {
      "description": "Hibernate core and JCache integration are version-coupled",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "org.hibernate.orm:hibernate-core",
        "org.hibernate.orm:hibernate-jcache"
      ],
      "groupName": "Hibernate core and JCache"
    },
    {
      "description": "Keep the Netty BOM and explicit DNS codec pin aligned",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["io.netty:netty-bom", "io.netty:netty-codec-dns"],
      "groupName": "Netty BOM and DNS codec"
    },
    {
      "description": "Keep Log4j API and its SLF4J bridge on the same release",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["org.apache.logging.log4j:log4j-*"],
      "groupName": "Log4j API and SLF4J bridge"
    },
    {
      "description": "Keep Jackson 2 security pins aligned",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["com.fasterxml.jackson.core:jackson-*"],
      "groupName": "Jackson 2 dependencies"
    },
    {
      "description": "Keep Jackson 3 security pins aligned",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["tools.jackson.core:jackson-*"],
      "groupName": "Jackson 3 dependencies"
    },
    {
      "description": "React Navigation packages share React Native peer-dependency constraints",
      "matchManagers": ["npm"],
      "matchFileNames": ["mobile/package.json"],
      "matchPackageNames": ["@react-navigation/**"],
      "groupName": "React Navigation"
    },
    {
      "description": "Keep native test tooling aligned with its React Native compatibility requirements",
      "matchManagers": ["npm"],
      "matchFileNames": ["mobile/package.json"],
      "matchPackageNames": [
        "@config-plugins/detox",
        "@testing-library/react-native",
        "detox"
      ],
      "groupName": "React Native test tooling"
    },
    {
      "description": "Blocked on Expo SDK 57: @babel/core 8 / jest 30 / @types/jest 30 require babel-preset-expo & jest-expo versions that do not yet support these majors. Keep pending on the dashboard; no PR until the SDK is upgraded.",
      "matchManagers": ["npm"],
      "matchFileNames": ["mobile/package.json"],
      "matchPackageNames": ["@babel/core", "jest", "@types/jest"],
      "matchUpdateTypes": ["major"],
      "labels": ["blocked-on-expo-sdk"],
      "groupName": "Blocked on Expo SDK upgrade",
      "dependencyDashboardApproval": true
    }
  ]
}
