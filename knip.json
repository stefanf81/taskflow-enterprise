{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["k6/*.js"],
      "ignoreDependencies": ["k6", "jsdom", "test-renderer"]
    },
    "frontend": {
      "entry": ["src/app/types/api.ts"]
    },
    "mobile": {
      "entry": [
        "App.tsx",
        "src/types/api.ts",
        ".detoxrc.js",
        "e2e/jest.config.js",
        "plugins/*.js"
      ],
      "ignoreBinaries": ["eas"]
    },
    "shared/domain": {},
    "shared/schemas": {}
  }
}
